# Copy this file to .env (next to main.py) and fill in real values.
# .env is git-ignored.

# Folder on the server that holds <user>/<task>/<project>/<version>/
NOCODE_PROJECTS_ROOT= # base folder path

# Node backend's internal API (No-Code-Node-Server docs/internal-api.md).
# Loopback only, no token: must point at 127.0.0.1 and the backend's INTERNAL_PORT.
NODE_INTERNAL_VERSIONS_URL=http://127.0.0.1:3101/internal/cleanup/versions
NODE_INTERNAL_TIMEOUT_SECONDS=30

# A version becomes a cleanup candidate this many days after its training completed
CLEANUP_RETENTION_DAYS=7
